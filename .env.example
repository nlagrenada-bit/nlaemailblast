# ---- Supabase -------------------------------------------------------------
# Browser-safe. The anon key is protected by row level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Server only. Never prefix with VITE_ — that would ship it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---- Images in the email --------------------------------------------------
# Absolute, publicly reachable base URL for logos, symbols and balls.
# Netlify itself works: https://your-site.netlify.app/assets
# Or a Supabase Storage public bucket:
#   https://YOUR-PROJECT.supabase.co/storage/v1/object/public/nla-assets
VITE_ASSET_BASE_URL=https://your-site.netlify.app/assets

# ---- Email provider -------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
# Must be a verified sending domain at the provider.
MAIL_FROM="National Lotteries Authority <results@nla.gd>"
MAIL_REPLY_TO=results@nla.gd
# Shown in the To: line; real recipients are BCC'd.
MAIL_ENVELOPE=results@nla.gd
BATCH_SIZE=45
BATCH_DELAY_MS=600

# ---- Nightly job ----------------------------------------------------------
TZ_OFFSET_HOURS=-4
DESK_NOTIFY_TO=supervisor@nla.gd,operations@nla.gd
