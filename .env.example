# ---- Supabase -------------------------------------------------------------
# Browser-safe. The anon key is protected by row level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Server only. Never prefix with VITE_ — that would ship it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---- Images in the email --------------------------------------------------
# Absolute, publicly reachable base URL for logos, symbols and balls.
# Netlify itself works: https://your-site.netlify.app/assets
# Or a Supabase Storage public bucket:
#   https://YOUR-PROJECT.supabase.co/storage/v1/object/public/nla-assets
VITE_ASSET_BASE_URL=https://your-site.netlify.app/assets

# ---- Email provider -------------------------------------------------------
# 'smtp' routes through Microsoft 365 (or any SMTP server). 'resend' uses the
# Resend API instead. Default is smtp.
EMAIL_PROVIDER=smtp

# Microsoft 365 SMTP. Requires "Authenticated SMTP" enabled on the mailbox in
# the M365 admin center, and an app password if the mailbox has MFA.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=results@nla.gd
SMTP_PASS=your-app-password

# From/reply identity. MAIL_FROM's address must match the SMTP mailbox, or
# Microsoft 365 will refuse to send on its behalf.
MAIL_FROM="National Lotteries Authority <results@nla.gd>"
MAIL_REPLY_TO=results@nla.gd
# Shown in the To: line; real recipients are BCC'd.
MAIL_ENVELOPE=results@nla.gd

# Under 500 for Microsoft 365. 100 keeps any single failure small.
BATCH_SIZE=100
BATCH_DELAY_MS=1200

# Only needed if EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...

# ---- Nightly job ----------------------------------------------------------
TZ_OFFSET_HOURS=-4
DESK_NOTIFY_TO=supervisor@nla.gd,operations@nla.gd

# ---- Website results integration (optional) -------------------------------
# When set, published results are POSTed to the NLA website's receiving
# endpoint. Leave WEBSITE_WEBHOOK_URL unset to keep the feature off.
# WEBSITE_WEBHOOK_URL=https://www.nla.gd/api/results-webhook
# WEBSITE_WEBHOOK_SECRET=a-long-random-shared-secret
